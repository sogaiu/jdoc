(defn replace
  "Replaces existing node at `zloc` with `node`, without moving."
  [zloc node]
  (let [[_ st] zloc]
    [node
     (make-state zloc
                 (st :ls)
                 (st :rs)
                 (st :pnodes)
                 (st :pstate)
                 true)]))

