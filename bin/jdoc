      down
      right
      node)
  # =>
  :b

  (-> (zip [:a])
      down
      right)
  # =>
  nil

  )

(defn make-node
  ``
  Returns a branch node, given `zloc`, `node` and `children`.
  ``
  [zloc node children]
  (((state zloc) :make-node) node children))

(comment

  (make-node (zip [:a :b [:x :y]])
             [:a :b] [:x :y])
  # =>
  [:x :y]

  )

(defn up
  ``
  Moves up the tree, returning the parent z-location of `zloc`,
  or nil if at the root z-location.
  ``
  [zloc]
  (let [[node st] zloc
        {:ls ls
         :pnodes pnodes
         :pstate pstate
         :rs rs
         :changed? changed?} st]
    (when pnodes
      (let [pnode (last pnodes)]
        (if changed?
          [(make-node zloc pnode [;ls node ;rs])
           (make-state zloc
                       (pstate :ls)
                       (pstate :rs)
                       (pstate :pnodes)
                       (pstate :pstate)
                       true)]
          [pnode pstate])))))

