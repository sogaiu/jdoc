        "  to avoid unwanted variable capture of `my-custom-macro`.``")
      :params-str "[f & args]"}]

  (find-doc-of
    ``
    (def smile "a docstring" 1)

    (defn smile
      "I am a docstring."
      [y]
      (pp y))
    ``
    {:name "smile"})
  # =>
  @[@{:bc 12 :bl 1
      :def-type "def"
      :text `"a docstring"`}
    @{:bc 3 :bl 4
      :def-type "defn"
      :text `"I am a docstring."`
      :params-str "[y]"}]

  )

(defn find-docs
  [src &opt opts]
  (default opts {})
  (def {:pred pred} opts)
  #
  (def tree (par src))
  (var cur-zloc (zip-down tree))
  (def results @[])
  #
  (while (def next-zloc
           (search-from cur-zloc
                          |(match (node $)
                             [:tuple]
                             $)))
    (def node (node next-zloc))
    (def raw-code-str (gen node))
    (def parsed
      (try
        (parse raw-code-str)
        ([e]
          (eprintf "failed to parse: %s" raw-code-str))))
    (when (and parsed
               (if-not pred true (pred parsed)))
      (when-let [head (first parsed)]
        (when (symbol? head)
          (def name (string (get parsed 1)))
          (cond
            (and (get special-definers head)
                 (<= 4 (length parsed))) # metadata possible
            (when-let [ds-tbl (find-special-docstring (down next-zloc))]
              (array/push results
                          (merge ds-tbl {:def-type (string head)
                                         :name name})))
            #
            (get call-definers head)
            (when-let [ds-tbl (find-caller-docstring (down next-zloc))]
            (array/push results
                        (merge ds-tbl {:def-type (string head)
                                       :name name})))
            #
            (and (= 'defdyn head) (= 3 (length parsed)))
            (when-let [ds-tbl (find-defdyn-docstring (down next-zloc))]
              (array/push results
                          (merge ds-tbl {:def-type (string head)
                                         :name name})))
            # XXX: other cases?
            nil))))
    #
    (set cur-zloc (df-next next-zloc)))
  #
  results)

