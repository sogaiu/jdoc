(defn massage-param-str
  [in-str]
  (peg/replace-all ~(some (choice " " "\r" "\n"))
                   " " in-str))

(comment

  (massage-param-str
    (string "root &keys {:branch? branch?\n"
            "    :children children\n"
            "        :make-node make-node}"))
  # =>
  (buffer "root &keys {:branch? branch? "
          ":children children "
          ":make-node make-node}")

  )

(def janet-indent
  "Default indentation that the built-in `doc-format` uses."
  4)

# XXX: this only works for no indentation
(def indent-ws "")

(defn dedent
  [region &opt amount]
  (default amount janet-indent)
  (def d-lines
    (->> (string/split "\n" region)
         (map |(if (<= amount (length $))
                 (string/slice $ amount)
                 $))))
  (string/join d-lines "\n"))

(comment

  (dedent (string "    line one\n"
                  "    line two\n"
                  "    line three")
          4)
  # =>
  (string "line one\n"
          "line two\n"
          "line three")

  )

(defn make-line-1
  [def-type]
  (def key (symbol def-type))
  (cond
    (get special-definers key)
    (string/format "%svalue (%s)" indent-ws def-type)
    #
    (get func-definers key)
    (string/format "%sfunction (%s)" indent-ws def-type)
    #
    (get macro-definers key)
    (string/format "%smacro (%s)" indent-ws def-type)
    #
    (= "defdyn" def-type)
    (string/format "%sdynamic variable" indent-ws)
    #
    (errorf "unknown def-type: %n" def-type)))

(defn search-and-report
  [opts]
  (def {:query-fn query-fn
        :name name} opts)
  #
  (def [all-results _] (search-paths query-fn opts))
  (when (zero? (length all-results))
    (break false))
  #
  (print)
  (each r all-results
    (def {:path path :bl line-no :bc col-no
          :def-type def-type :text pre-str
          :params-str params-str} r)
    (def line-1 (make-line-1 def-type))
    (def line-2 (string/format "%s%s on line %d, column %d"
                               indent-ws path line-no col-no))
    (def name (if name name (get r :name)))
    (def usage
      (if-not (get r :params-str)
        name
        (let [# ensure string is one line
              line-str (massage-param-str params-str)
              # drop surrounding delimiters
              inner-str (string/slice line-str 1 -2)]
          (string/format "(%s %s)" name inner-str))))
    (def leading-ws (string/repeat " " (dec col-no)))
    (def doc-str
      (string/format "%s\n\n%s" usage
                     # sometimes long-string dedenting is needed, so
                     # prepend proper amount of whitespace
                     (parse (string leading-ws pre-str))))
    (def bottom
      (string/format "%s%s"
                     indent-ws
                     (dedent (string/trim (doc-format doc-str) "\n"))))
    (def fmt (string "%s\n"
                     "%s\n"
                     "\n"
                     "%s\n"))
    (printf fmt line-1 line-2 bottom)
    # XXX: 72 = 80 - 8 (from janet's `boot.janet`)
    (def width (- (- (dyn :doc-width 80) 8)
                  janet-indent))
    (printf (string/repeat "-" width))
    (print))
  #
  all-results)

########################################################################

(defn escape
  [name]
  # XXX: doing multiple linear searches seems bad
  (cond
    (string/find "*" name)
    (string "\"" name "\"")
    #
    (string/find "<" name)
    (string "\"" name "\"")
    #
    (string/find ">" name)
    (string "\"" name "\"")
    # XXX: any other characters to be careful of?
    name))

(comment

  (escape "*")
  # =>
  `"*"`

  (escape "<")
  # =>
  `"<"`

  (escape ">")
  # =>
  `">"`

  (escape "!")
  # =>
  "!"

  )

########################################################################

(defn do-all-docs
  [opts]
  (def {:rest the-args} opts)
  #
  (def includes the-args)
  # find .janet files
  (def src-filepaths
    (collect-paths includes |(or (string/has-suffix? ".janet" $)
                                 (has-janet-shebang? $))))
  #
  (search-and-report {:query-fn find-docs
                      :paths src-filepaths}))

(defn do-doc-of
  [opts]
  (def {:rest the-args} opts)
  #
  (def name (get the-args 0))
  (array/remove the-args 0)
  #
  (def includes the-args)
  # find .janet files
  (def src-filepaths
    (collect-paths includes |(or (string/has-suffix? ".janet" $)
                                 (has-janet-shebang? $))))
  #
  (search-and-report {:query-fn find-doc-of
                      :paths src-filepaths :name name}))

########################################################################

(def not-found-message "Nothing found")

(defn is-index?
  [doc-buf]
  (when (not (string/has-prefix? "Bindings:" (string/trim doc-buf)))
    (break false))
  #
  (def parts (->> (string/trim doc-buf)
                  (string/split "\n\n")
                  (map string/trim)
                  (filter |(not (empty? $)))))
  # remove the trailing text "Use (doc sym)..."
  (array/pop parts)
  #
  (assertf (= "Bindings:" (get parts 0))
           `expected "Bindings:" but got: %n for: %n`
           (get parts 0) doc-buf)
  (array/remove parts 0)
  (def bindings
    (let [target (get parts 0)]
      (if (= "Dynamics:" target)
        @[]
        (let [bz (->> (string/replace-all "\n" " " target)
                      (string/split " ")
                      (filter |(not (empty? $))))]
          (array/remove parts 0)
          bz))))
  # next thing is "Dynamics:", remove it
  (array/remove parts 0)
  #
  (def dynamics
    (let [target (get parts 0)]
      (cond
        (not target)
        @[]
        (defer (array/remove parts 0)
          (->> (string/replace-all "\n" " " target)
               (string/split " ")
               (filter |(not (empty? $))))))))
  #
  [bindings dynamics])

# doc and doc* are tricky because they internally end up leading to
# calls to (all-bindings) and (all-dynamics)...which in their zero
# argument versions don't allow specifying to look only in a
# specific environment and/or just look for locals.  the use of the
# fiber below is a work-around so that information from this script
# doesn't end up "polluting" the results.  eval-string with an
# environment set to root-env didn't appear to work...
(defn do-doc
  [doc-arg]
  (def fib (fiber/new (fn [doc-arg]
                        (def buf @"")
                        (with-dyns [:out buf] (doc* doc-arg))
                        buf)
                      :y root-env))
  #
  (resume fib doc-arg))

(defn report-index
  [[bindings dynamics]]
  #
  (when (and (empty? bindings) (empty? dynamics))
    (print not-found-message)
    (break))
  #
  (when bindings
    (printf "%sBindings found:" indent-ws)
    (print)
    (each b bindings (printf "%s%s" indent-ws b)))
  #
  (when dynamics
    (printf "%sDynamics found:" indent-ws)
    (print)
    (each d dynamics (printf "%s%s" indent-ws d))))

(defn massage-doc
  [doc-arg doc-buf]
  #
  (def trimmed (string/trim doc-buf "\n"))
  #
  (def arg-type (-> (string/split "\n" trimmed)
                    first
                    string/trim))
  #
  (when (get {"function" 1 "cfunction" 1 "macro" 1} arg-type)
    (break (dedent trimmed)))
  #
  (def parts (string/split "\n\n" trimmed))
  (when (not parts)
    (errorf "failed to parse docstring: %s" doc-buf))
  #
  (def [pre post] parts)
  #
  (def pre-d (dedent pre))
  (def post-d (dedent post))
  #
  (string/format "%s\n\n%s%s\n\n%s" pre-d indent-ws doc-arg post-d))

(defn report-item
  [doc-arg doc-buf]
  (print)
  (print (massage-doc doc-arg doc-buf))
  (print))

########################################################################

(defn main
  [_ & args]
  (def opts (parse-args args))
  #
  (def {:rest the-args} opts)
  #
  (def arg (get the-args 0))
  #
  (def root-bindings (all-bindings root-env))
  #
  (cond
    (def ui (get opts :unknown-item))
    (do
      (eprintf "unrecognized option or symbol: %s" ui)
      (eprint "Try jdoc -h for usage.")
      (os/exit 1))
    #
    (get opts :help)
    (print usage)
    #
    (get opts :bash-completion)
    (print bash-completion)
    #
    (get opts :fish-completion)
    (print fish-completion)
    #
    (get opts :zsh-completion)
    (print zsh-completion)
    # mostly for supporting shell completion
    (get opts :raw-all)
    (each binding root-bindings
      (print (escape binding)))
    # enumerate docs for files and/or directories
    (get opts :enum-docs)
    (let [results (do-all-docs opts)]
      (when (not results)
        (print not-found-message)))
    # base results on files and/or directories searching
    (get opts :paths-search)
    (let [results (do-doc-of opts)]
      (when (not results)
        (print not-found-message)))
    # base results on janet built-ins
    (get opts :builtins-search)
    (let [doc-arg
          (if arg
            (let [sym (symbol arg)]
              (if (get root-env sym)
                sym
                (string/format `"%s"` arg)))
            (when (get opts :random)
              (def idx (math/rng-int (math/rng (os/cryptorand 3))
                                     (length root-bindings)))
              (get root-bindings idx)))]
      (when (not doc-arg)
        (print usage)
        (os/exit 0))
      #
      (def buf (do-doc doc-arg))
      #
      (if-let [index (is-index? buf)]
        (report-index index)
        (report-item doc-arg buf)))
    # XXX: don't expect to get here
    (errorf "bug somewhere: args: %n opts: %n" args opts)))

